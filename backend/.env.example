# Application Settings
APP_NAME=ConvoSynth Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=convosynth

# Security Settings
# Generate a new SECRET_KEY using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters-CHANGE-THIS
ACCESS_TOKEN_EXPIRE_MINUTES=720

# AI/LLM Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Conversation Agent Settings (Optional)
CONVERSATION_AGENT_MAX_ITERATIONS=10
CONVERSATION_AGENT_MAX_EXECUTION_TIME=120

# CORS Settings (Optional)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging (Optional)
LOG_LEVEL=INFO
