{
  "agentName": "Query Agent",
  "primaryFunction": "Draft targeted queries, retrieve context from RAG engine, and enhance responses through LLM processing for both generation and editing cycles",
  "llmSelection": "Claude-4-Sonnet",
  "performanceTargets": {
    "responseTime": "<2s per query",
    "accuracyTarget": "98% intent accuracy",
    "retrievalQuality": "95% context relevance"
  },
  "dataFlow": {
    "inputSchema": {
      "sessionId": "string",
      "userId": "string",
      "queryAgentId": "string",
      "cycleType": "enum: ['generation', 'editing']",
      "extractedInformation": {
        "presentationRequirements": {
          "topic": "string",
          "targetAudience": "string or null",
          "numSlides": "number",
          "keyThemes": ["array of strings"],
          "tone": "string or null",
          "objectives": "string or null"
        },
        "dataRequirements": {
          "documentsRequested": ["array of document names"],
          "contentToExtract": ["array of specific content types"],
          "metrics": ["array of metrics/KPIs"],
          "timePeriods": ["array of time periods"],
          "comparisons": ["array of comparison types"],
          "dataCategories": ["array of data categories"]
        },
        "visualPreferences": {
          "chartTypes": ["array of chart types"],
          "style": "string or null",
          "includeImages": "boolean or null",
          "colorScheme": "string or null"
        },
        "editingRequirements": {
          "editType": "enum: ['content', 'structure', 'general'] or null",
          "targetSlide": "number or null",
          "specificChanges": ["array of requested changes"],
          "editScope": "enum: ['single_slide_content', 'multiple_slides_content', 'entire_presentation_content'] or null"
        }
      },
      "selectedDocuments": [
        {
          "documentId": "string",
          "documentName": "string",
          "docType": "string",
          "department": "string",
          "relevanceScore": "number",
          "extractionGuidance": {
            "targetSections": ["array of section names"],
            "relevantMetrics": ["array of metrics to extract"],
            "relevantTimePeriods": ["array of time periods"]
          }
        }
      ],
      "retrievalParams": {
        "topK": "number (default: 10)",
        "similarityThreshold": "number (default: 0.7)",
        "maxTokensPerQuery": "number (default: 2000)",
        "retrievalStrategy": "enum: ['dense', 'hybrid', 'multi_hop'] (default: 'hybrid')"
      },
      "editingContext": {
        "isEditing": "boolean",
        "previousQueries": [
          {
            "queryId": "string",
            "queryText": "string",
            "retrievedContext": "string (summary)"
          }
        ],
        "currentSlideContent": {
          "slideNumber": "number or null",
          "existingContext": "string or null"
        }
      },
      "timestamp": "string (ISO 8601)"
    },

    "outputSchema": {
      "sessionId": "string",
      "userId": "string",
      "queryAgentId": "string",
      "cycleType": "enum: ['generation', 'editing']",
      "queryResults": [
        {
          "queryId": "string",
          "queryIntent": {
            "intentType": "enum: ['metric_extraction', 'trend_analysis', 'comparison', 'summary', 'specific_fact']",
            "targetDocuments": ["array of document IDs"],
            "targetSections": ["array of section names"],
            "targetMetrics": ["array of metrics"],
            "targetTimePeriods": ["array of time periods"]
          },
          "draftedQuery": {
            "queryText": "string",
            "queryType": "enum: ['semantic', 'keyword', 'hybrid']",
            "contextFilters": {
              "documentIds": ["array of document IDs"],
              "sections": ["array of section names"],
              "dateRange": {
                "start": "string or null",
                "end": "string or null"
              }
            }
          },
          "ragRetrieval": {
            "retrievedChunks": [
              {
                "chunkId": "string",
                "documentId": "string",
                "documentName": "string",
                "sectionName": "string",
                "content": "string",
                "relevanceScore": "number (0.0-1.0)",
                "metadata": {
                  "pageNumber": "number or null",
                  "chunkIndex": "number",
                  "tokenCount": "number"
                }
              }
            ],
            "totalChunksRetrieved": "number",
            "averageRelevanceScore": "number",
            "retrievalTime": "string (e.g., '0.5s')"
          },
          "llmEnhancedAnswer": {
            "answer": "string (LLM-processed and contextualized response)",
            "confidence": "number (0.0-1.0)",
            "sourceReferences": [
              {
                "documentId": "string",
                "documentName": "string",
                "sectionName": "string",
                "snippet": "string (relevant excerpt)"
              }
            ],
            "extractedData": {
              "metrics": [
                {
                  "metricName": "string",
                  "value": "string or number",
                  "unit": "string or null",
                  "timePeriod": "string",
                  "sourceDocument": "string"
                }
              ],
              "insights": ["array of key insights"],
              "trends": ["array of identified trends"],
              "comparisons": [
                {
                  "comparisonType": "string (e.g., 'QoQ', 'YoY')",
                  "baseline": "string or number",
                  "current": "string or number",
                  "change": "string",
                  "percentChange": "number or null"
                }
              ]
            },
            "enhancementMetadata": {
              "llmModel": "string",
              "processingTime": "string",
              "tokenCount": "number"
            }
          },
          "relatedQueries": ["array of query IDs that provide related context"],
          "queryStatus": "enum: ['success', 'partial_success', 'failed']",
          "failureReason": "string or null"
        }
      ],
      "crossQueryContext": {
        "description": "Context maintained across related queries",
        "sharedEntities": ["array of entities mentioned across queries"],
        "temporalContext": {
          "primaryTimePeriod": "string",
          "comparisonPeriods": ["array of comparison periods"]
        },
        "thematicConnections": [
          {
            "theme": "string",
            "relatedQueries": ["array of query IDs"]
          }
        ]
      },
      "aggregatedMetadata": {
        "totalQueries": "number",
        "successfulQueries": "number",
        "totalChunksRetrieved": "number",
        "totalDocumentsUsed": "number",
        "averageRelevanceScore": "number",
        "totalProcessingTime": "string"
      },
      "nextAction": "enum: ['proceed_to_outline_agent', 'insufficient_context', 'retry_with_refined_queries']",
      "handoffToAgent": "string or null",
      "timestamp": "string (ISO 8601)"
    },

    "ragEngineIntegration": {
      "description": "Integration with main RAG engine after document ingestion",
      "ingestionProcess": {
        "triggerEvent": "Document Selection Agent completes selection",
        "ingestionSteps": [
          "1. Fetch selected documents from enterprise corpus",
          "2. Parse and chunk documents using RAG engine",
          "3. Generate embeddings for chunks",
          "4. Store in RAG vector database with metadata",
          "5. Index for efficient retrieval"
        ],
        "ingestionVerification": "Confirm all selected documents are indexed before Query Agent execution"
      },
      "retrievalMethods": {
        "dense": {
          "description": "Vector similarity search using embeddings",
          "useCase": "Semantic queries, conceptual searches"
        },
        "hybrid": {
          "description": "Combines dense vector search with keyword matching",
          "useCase": "Balanced approach for most queries (default)"
        },
        "multiHop": {
          "description": "Multi-step retrieval for complex queries requiring multiple document references",
          "useCase": "Comparative analysis, cross-document queries"
        }
      },
      "contextEnhancement": {
        "description": "LLM processing to enhance raw retrieved chunks",
        "enhancementSteps": [
          "1. Retrieve top-k chunks from RAG engine",
          "2. Pass chunks + query to Claude-4-Sonnet",
          "3. LLM synthesizes information, extracts key data, maintains context",
          "4. LLM generates structured answer with source references",
          "5. Extract metrics, insights, trends, comparisons",
          "6. Return enhanced answer with metadata"
        ],
        "contextMaintenance": {
          "description": "Maintain context across related queries",
          "techniques": [
            "Track shared entities and themes across queries",
            "Build temporal context (time periods, comparisons)",
            "Link related queries for coherent narrative",
            "Aggregate information for comprehensive understanding"
          ]
        }
      }
    },

    "queryDraftingLogic": {
      "generationMode": {
        "description": "Draft comprehensive queries for initial presentation generation",
        "queryTypes": [
          {
            "type": "overview_query",
            "purpose": "Get high-level summary of topic",
            "example": "What are the key highlights of Q3 operational performance?"
          },
          {
            "type": "metric_queries",
            "purpose": "Extract specific metrics and KPIs",
            "example": "What is the efficiency rate and productivity index for Q3 2024?"
          },
          {
            "type": "trend_queries",
            "purpose": "Identify trends and patterns",
            "example": "What are the efficiency trends from Q2 to Q3 2024?"
          },
          {
            "type": "comparison_queries",
            "purpose": "Perform temporal or categorical comparisons",
            "example": "How does Q3 2024 efficiency compare to Q2 2024 (QoQ)?"
          },
          {
            "type": "insight_queries",
            "purpose": "Extract actionable insights and recommendations",
            "example": "What are the key drivers of Q3 efficiency improvements?"
          }
        ],
        "queryOrdering": [
          "1. Start with overview queries for context",
          "2. Extract specific metrics and data points",
          "3. Analyze trends and patterns",
          "4. Perform comparisons",
          "5. Synthesize insights and recommendations"
        ],
        "queryCount": "5-15 queries depending on presentation complexity"
      },
      "editingMode": {
        "description": "Draft targeted queries for specific edit requirements",
        "optimizations": [
          "Reuse previous query results when possible",
          "Only draft new queries if edit requires new information",
          "Focus queries on edit scope (single slide vs. multiple slides)"
        ],
        "queryTypes": [
          {
            "type": "targeted_retrieval",
            "purpose": "Retrieve specific data for edit",
            "example": "What are the detailed efficiency metrics for Q3 2024?"
          },
          {
            "type": "refinement_query",
            "purpose": "Get additional details or alternative perspectives",
            "example": "What factors contributed to efficiency improvements in Q3?"
          },
          {
            "type": "supplementary_query",
            "purpose": "Add new information not in original presentation",
            "example": "What are the employee satisfaction scores for Q3 2024?"
          }
        ],
        "queryOrdering": [
          "1. Check if previousQueries contain needed information",
          "2. Draft only new queries for missing information",
          "3. Maintain context with existing query results"
        ],
        "queryCount": "1-5 targeted queries for edit scope"
      }
    },

    "cycleModes": {
      "generationMode": {
        "description": "Comprehensive query generation for initial presentation",
        "activeFields": [
          "presentationRequirements",
          "dataRequirements",
          "selectedDocuments"
        ],
        "ignoredFields": [
          "editingContext",
          "editingRequirements"
        ],
        "behavior": "Draft 5-15 queries covering overview, metrics, trends, comparisons, and insights"
      },
      "editingMode": {
        "description": "Targeted query generation for presentation edits",
        "activeFields": [
          "editingRequirements",
          "editingContext",
          "selectedDocuments"
        ],
        "requiredFields": [
          "editingContext.previousQueries",
          "editingContext.currentSlideContent"
        ],
        "behavior": "Optimize by reusing previous queries and only drafting new ones for missing information",
        "editScenarios": {
          "contentEditSameContext": {
            "description": "Edit uses same context (rewording, emphasis)",
            "action": "Reuse previousQueries, no new RAG retrieval needed"
          },
          "contentEditNewDetails": {
            "description": "Edit requires additional details from same documents",
            "action": "Draft 1-3 targeted queries for specific details"
          },
          "contentEditNewSources": {
            "description": "Edit requires information from new documents",
            "action": "Draft 2-5 queries targeting new documents"
          },
          "structureEdit": {
            "description": "Slide reordering or restructuring",
            "action": "Usually no new queries needed, reuse existing context"
          }
        }
      }
    }
  },

  "rationale": "Superior information retrieval and context synthesis skills with Claude-4-Sonnet for accurate query understanding, RAG retrieval, and LLM enhancement",

  "integrationPoints": {
    "inputFrom": [
      "Conversation Agent (extracted information)",
      "Document Selection Agent (selected documents with extraction guidance)"
    ],
    "handoffAgents": [
      "Outline Agent (after successful context retrieval and enhancement)"
    ],
    "dataStores": {
      "ragEngine": "Main RAG engine with ingested selected documents",
      "redis": "Cache query results and enhanced answers for reuse in editing"
    },
    "externalSystems": {
      "ragIngestionPipeline": "Triggered before Query Agent to ingest selected documents"
    }
  },

