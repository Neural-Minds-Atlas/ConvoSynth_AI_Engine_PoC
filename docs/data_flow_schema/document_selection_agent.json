{
  "agentName": "Document Selection Agent",
  "primaryFunction": "Intelligently filter relevant documents from enterprise corpus using metadata RAG based on user requirements for both generation and editing cycles",
  "llmSelection": "Cohere",
  "performanceTargets": {
    "responseTime": "<3s",
    "accuracyTarget": "95% relevance"
  },
  "dataFlow": {
    "inputSchema": {
      "sessionId": "string",
      "userId": "string",
      "selectionId": "string",
      "cycleType": "enum: ['generation', 'editing']",
      "userRequirements": {
        "presentationRequirements": {
          "topic": "string",
          "targetAudience": "string or null",
          "numSlides": "number",
          "keyThemes": ["array of strings"],
          "tone": "string or null",
          "objectives": "string or null"
        },
        "dataRequirements": {
          "documentsRequested": ["array of document names"],
          "contentToExtract": ["array of specific content types"],
          "metrics": ["array of metrics/KPIs"],
          "timePeriods": ["array of time periods"],
          "comparisons": ["array of comparison types"],
          "dataCategories": ["array of data categories"]
        },
        "visualPreferences": {
          "chartTypes": ["array of chart types"],
          "style": "string or null",
          "includeImages": "boolean or null",
          "colorScheme": "string or null"
        },
        "editingRequirements": {
          "editType": "enum: ['content', 'structure', 'general'] or null",
          "targetSlide": "number or null",
          "specificChanges": ["array of requested changes"],
          "editScope": "enum: ['single_slide_content', 'multiple_slides_content', 'entire_presentation_content'] or null"
        }
      },
      "accessibleDocuments": [
        {
          "documentId": "string",
          "documentName": "string",
          "docType": "string",
          "department": "string",
          "accessLevel": "string",
          "summary": "string",
          "tags": ["array of strings"],
          "topics": ["array of strings"]
        }
      ],
      "filters": {
        "docTypes": ["array of strings"],
        "dateRange": {
          "startDate": "string (ISO 8601) or null",
          "endDate": "string (ISO 8601) or null"
        },
        "departments": ["array of strings or null"],
        "maxDocuments": "number (default: 10)"
      },
      "editingContext": {
        "isEditing": "boolean",
        "previouslySelectedDocuments": [
          {
            "documentId": "string",
            "documentName": "string",
            "relevanceScore": "number"
          }
        ]
      },
      "timestamp": "string (ISO 8601)"
    },

    "outputSchema": {
      "sessionId": "string",
      "userId": "string",
      "selectionId": "string",
      "cycleType": "enum: ['generation', 'editing']",
      "selectedDocuments": [
        {
          "documentId": "string",
          "documentName": "string",
          "docType": "string",
          "department": "string",
          "accessLevel": "string",
          "relevanceScore": "number (0.0-1.0)",
          "selectionReason": "string",
          "priority": "enum: ['high', 'medium', 'low']",
          "matchedCriteria": {
            "topicMatch": "boolean",
            "metricsMatch": "boolean",
            "timePeriodMatch": "boolean",
            "categoryMatch": "boolean"
          },
          "extractionGuidance": {
            "targetSections": ["array of section names"],
            "relevantMetrics": ["array of metrics to extract"],
            "relevantTimePeriods": ["array of time periods"]
          },
          "editingMetadata": {
            "isNewDocument": "boolean (true if not in previouslySelectedDocuments)",
            "replacesDocument": "string or null (document ID being replaced)",
            "editReason": "string or null (why this document is needed for the edit)"
          }
        }
      ],
      "selectionMetadata": {
        "totalDocumentsConsidered": "number",
        "totalDocumentsSelected": "number",
        "averageRelevanceScore": "number",
        "selectionStrategy": "string",
        "queryExecutionTime": "string (e.g., '2.3s')",
        "editingMetadata": {
          "documentsRetained": "number (documents kept from previous selection)",
          "documentsAdded": "number (new documents added for edit)",
          "documentsRemoved": "number (documents no longer needed)"
        }
      },
      "metadataRAGQueries": [
        {
          "queryId": "string",
          "queryText": "string",
          "queryType": "enum: ['semantic', 'keyword', 'hybrid']",
          "resultsCount": "number"
        }
      ],
      "documentChangeAnalysis": {
        "retainedDocuments": ["array of document IDs kept from previous selection"],
        "addedDocuments": ["array of document IDs newly added"],
        "removedDocuments": ["array of document IDs no longer needed"],
        "changeReason": "string (explanation of why document selection changed)"
      },
      "nextAction": "enum: ['proceed_to_query_agent', 'insufficient_documents', 'refine_selection', 'no_document_change_needed']",
      "handoffToAgent": "string or null",
      "timestamp": "string (ISO 8601)"
    },

    "metadataRAGEngine": {
      "description": "Queries metadata RAG to find relevant documents based on user requirements",
      "queryGeneration": {
        "semanticQueries": [
          "Generate queries based on presentation topic and key themes",
          "Generate queries based on data categories and metrics",
          "Generate queries based on time periods and comparisons"
        ],
        "keywordQueries": [
          "Extract explicit document names mentioned by user",
          "Extract specific metrics/KPIs for exact matching",
          "Extract department and doc_type filters"
        ],
        "hybridQueries": [
          "Combine semantic understanding with keyword precision",
          "Weight queries based on user requirements specificity"
        ]
      },
      "metadataFields": {
        "searchableFields": [
          "document_id",
          "title",
          "summary",
          "department",
          "doc_type",
          "tags",
          "topics",
          "section_titles",
          "date_created",
          "last_modified"
        ],
        "filterableFields": [
          "department",
          "doc_type",
          "access_level",
          "date_created",
          "last_modified",
          "version"
        ]
      },
      "rankingStrategy": {
        "factors": [
          "Semantic similarity to topic and themes",
          "Presence of requested metrics/KPIs",
          "Time period alignment",
          "Document type relevance",
          "Recency (if applicable)"
        ],
        "weightings": {
          "topicRelevance": 0.35,
          "metricsMatch": 0.25,
          "timePeriodMatch": 0.20,
          "docTypeMatch": 0.15,
          "recency": 0.05
        }
      }
    },

    "selectionLogic": {
      "generationMode": {
        "steps": [
          "1. Parse user requirements and extract key selection criteria",
          "2. Generate multiple metadata RAG queries (semantic + keyword + hybrid)",
          "3. Execute queries against metadata RAG engine",
          "4. Aggregate and deduplicate results",
          "5. Score documents based on multi-factor relevance",
          "6. Filter by accessible documents (RBAC pre-filtered)",
          "7. Rank and select top N documents based on maxDocuments",
          "8. Generate extraction guidance for each selected document",
          "9. Return selected documents with metadata"
        ]
      },
      "editingMode": {
        "steps": [
          "1. Analyze editing requirements and determine if new documents are needed",
          "2. Check if existing document sources can fulfill the edit request",
          "3. If new data/metrics needed: Generate targeted metadata RAG queries",
          "4. Execute queries for supplementary or replacement documents",
          "5. Compare new results with previouslySelectedDocuments",
          "6. Decide which documents to retain, add, or remove",
          "7. Generate extraction guidance specific to edit requirements",
          "8. Return updated document selection with change analysis"
        ],
        "optimizations": [
          "Reuse existing documents when possible to minimize RAG queries",
          "Only query for new documents if edit requires new data sources",
          "Prioritize documents already in context for efficiency",
          "For content edits within same topic: Often no new documents needed"
        ]
      },
      "fallbackStrategies": [
        "If no documents found: Broaden semantic queries",
        "If too many documents: Apply stricter filters (doc_type, date_range)",
        "If low relevance scores: Suggest refinement to user requirements",
        "If editing and no new documents needed: Return previouslySelectedDocuments with no_document_change_needed action"
      ]
    },

    "cycleModes": {
      "generationMode": {
        "description": "Initial document selection for presentation generation",
        "activeFields": [
          "presentationRequirements",
          "dataRequirements",
          "visualPreferences"
        ],
        "ignoredFields": [
          "editingContext",
          "editingRequirements"
        ],
        "behavior": "Performs comprehensive document search and selection from scratch"
      },
      "editingMode": {
        "description": "Incremental document selection for presentation edits",
        "activeFields": [
          "editingRequirements",
          "editingContext",
          "dataRequirements (if new data needed)"
        ],
        "requiredFields": [
          "editingContext.previouslySelectedDocuments",
          "editingContext.currentSlideContent"
        ],
        "behavior": "Optimizes by reusing existing documents and only fetching new ones if edit requires additional data sources",
        "editScenarios": {
          "contentEditSameSources": {
            "description": "Edit uses same data sources (e.g., rewording, emphasis change)",
            "action": "Return previouslySelectedDocuments, set nextAction to no_document_change_needed"
          },
          "contentEditNewMetrics": {
            "description": "Edit requires new metrics from existing documents",
            "action": "Retain existing documents, update extractionGuidance with new target sections/metrics"
          },
          "contentEditNewSources": {
            "description": "Edit requires data from new documents",
            "action": "Query metadata RAG for new documents, add to selection, provide change analysis"
          },
          "structureEdit": {
            "description": "Slide reordering or restructuring",
            "action": "Usually no new documents needed, return existing selection"
          }
        }
      }
    }
  },

  "rationale": "Superior semantic understanding for intelligent filtering and document selection using metadata RAG with efficient editing support",

  "integrationPoints": {
    "inputFrom": [
      "Conversation Agent (user requirements, accessible documents, and editing context)"
    ],
    "handoffAgents": [
      "Query Agent (after document selection complete for both generation and editing)"
    ],
    "dataStores": {
      "metadataRAG": "Metadata RAG engine containing document metadata (KG + VectorDB)",
      "redis": "Cache selection results for session reuse and edit history"
    }
  },

