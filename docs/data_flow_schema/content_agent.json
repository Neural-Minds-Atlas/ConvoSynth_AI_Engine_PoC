{
  "agentName": "Content Agent",
  "primaryFunction": "Generate comprehensive slide content by expanding outline with RAG-retrieved context, maintaining data accuracy and source attribution for both generation and editing cycles",
  "llmSelection": "Claude-4-Sonnet",
  "performanceTargets": {
    "responseTime": "<4s per slide",
    "accuracyTarget": "95% data accuracy",
    "contentQuality": "90% coherence and clarity"
  },
  "dataFlow": {
    "inputSchema": {
      "sessionId": "string",
      "userId": "string",
      "contentId": "string",
      "cycleType": "enum: ['generation', 'editing']",
      "presentationOutline": {
        "title": "string",
        "subtitle": "string or null",
        "totalSlides": "number",
        "slides": [
          {
            "slideNumber": "number",
            "slideType": "string",
            "title": "string",
            "bulletPoints": [
              {
                "bulletText": "string",
                "subBullets": ["array of strings or null"],
                "requiresData": "boolean",
                "dataMapping": {
                  "queryId": "string or null",
                  "metricName": "string or null",
                  "dataType": "string or null"
                }
              }
            ],
            "visualHints": ["array of visual hint objects"],
            "speakerNotes": "string or null",
            "keyMessage": "string"
          }
        ]
      },
      "queryResults": [
        {
          "queryId": "string",
          "llmEnhancedAnswer": {
            "answer": "string",
            "confidence": "number",
            "sourceReferences": [
              {
                "documentId": "string",
                "documentName": "string",
                "sectionName": "string",
                "snippet": "string"
              }
            ],
            "extractedData": {
              "metrics": ["array of metric objects"],
              "insights": ["array of strings"],
              "trends": ["array of strings"],
              "comparisons": ["array of comparison objects"]
            }
          },
          "ragRetrieval": {
            "retrievedChunks": [
              {
                "chunkId": "string",
                "documentId": "string",
                "documentName": "string",
                "sectionName": "string",
                "content": "string",
                "relevanceScore": "number"
              }
            ]
          }
        }
      ],
      "contentRequirements": {
        "detailLevel": "enum: ['executive_summary', 'detailed', 'comprehensive'] (default: 'detailed')",
        "tone": "string (e.g., 'professional', 'casual', 'technical')",
        "includeDataPoints": "boolean (default: true)",
        "includeCitations": "boolean (default: true)",
        "expandBullets": "boolean (default: true)",
        "maxWordsPerBullet": "number (default: 25)",
        "includeContextualExplanations": "boolean (default: true)"
      },
      "ragEngineAccess": {
        "description": "Direct access to RAG engine for additional context retrieval if needed",
        "enabled": "boolean (default: true)",
        "retrievalParams": {
          "topK": "number (default: 5)",
          "similarityThreshold": "number (default: 0.7)"
        }
      },
      "editingContext": {
        "isEditing": "boolean",
        "previousContent": {
          "contentId": "string or null",
          "slides": [
            {
              "slideNumber": "number",
              "title": "string",
              "content": {
                "mainText": "string",
                "bulletPoints": ["array of content bullet objects"],
                "dataVisualizations": ["array of data viz objects"],
                "citations": ["array of citation objects"]
              },
              "speakerNotes": "string"
            }
          ]
        },
        "targetSlidesForEdit": ["array of slide numbers to regenerate"],
        "preserveOtherSlides": "boolean (default: true)"
      },
      "timestamp": "string (ISO 8601)"
    },

    "outputSchema": {
      "sessionId": "string",
      "userId": "string",
      "contentId": "string",
      "cycleType": "enum: ['generation', 'editing']",
      "expandedContent": {
        "presentationTitle": "string",
        "presentationSubtitle": "string or null",
        "totalSlides": "number",
        "slides": [
          {
            "slideNumber": "number",
            "slideType": "string",
            "title": "string",
            "content": {
              "mainText": "string (2-3 sentence summary of slide key message)",
              "bulletPoints": [
                {
                  "bulletText": "string (full expanded bullet point content)",
                  "subBullets": [
                    {
                      "text": "string",
                      "dataPoint": {
                        "value": "string or number or null",
                        "unit": "string or null",
                        "context": "string or null"
                      }
                    }
                  ],
                  "dataPoint": {
                    "metricName": "string or null",
                    "value": "string or number or null",
                    "unit": "string or null",
                    "timePeriod": "string or null",
                    "comparison": "string or null",
                    "sourceQueryId": "string or null"
                  },
                  "citation": {
                    "documentName": "string or null",
                    "sectionName": "string or null",
                    "pageNumber": "string or null"
                  }
                }
              ],
              "dataVisualizations": [
                {
                  "visualizationId": "string",
                  "visualType": "string (e.g., 'bar_chart', 'line_chart', 'table')",
                  "title": "string",
                  "data": {
                    "labels": ["array of strings"],
                    "datasets": [
                      {
                        "label": "string",
                        "values": ["array of numbers"],
                        "metadata": "object or null"
                      }
                    ]
                  },
                  "sourceQueryIds": ["array of query IDs"],
                  "chartConfiguration": {
                    "xAxisLabel": "string or null",
                    "yAxisLabel": "string or null",
                    "colorScheme": "string or null"
                  }
                }
              ],
              "citations": [
                {
                  "citationId": "string",
                  "documentName": "string",
                  "sectionName": "string",
                  "pageNumber": "string or null",
                  "relevantTo": "string (which bullet point or data this cites)"
                }
              ],
              "contextualNotes": "string or null (additional context for complex slides)"
            },
            "speakerNotes": "string (detailed notes for presenter, 3-5 sentences)",
            "transitionHint": "string or null (suggested transition to next slide)"
          }
        ]
      },
      "contentMetadata": {
        "totalDataPoints": "number",
        "totalCitations": "number",
        "queriesUsed": ["array of query IDs used in content generation"],
        "ragRetrievalCount": "number (additional RAG calls made beyond queryResults)",
        "editingMetadata": {
          "slidesRegenerated": ["array of slide numbers regenerated"],
          "slidesPreserved": ["array of slide numbers preserved from previous"],
          "contentChangeSummary": "string or null"
        }
      },
      "qualityMetrics": {
        "dataAccuracy": "number (0.0-1.0, based on source alignment)",
        "contentCoherence": "number (0.0-1.0, narrative flow quality)",
        "citationCompleteness": "number (0.0-1.0, % of data claims cited)",
        "detailLevel": "enum: ['executive_summary', 'detailed', 'comprehensive']"
      },
      "validationChecks": {
        "allDataPointsSourced": "boolean",
        "allMetricsHaveUnits": "boolean",
        "citationsComplete": "boolean",
        "bulletPointLengthCompliant": "boolean",
        "noContradictions": "boolean"
      },
      "nextAction": "enum: ['proceed_to_qa_agent', 'refinement_needed', 'data_validation_required']",
      "handoffToAgent": "string or null",
      "timestamp": "string (ISO 8601)"
    },

    "contentGenerationLogic": {
      "generationMode": {
        "description": "Generate comprehensive content for all slides from outline",
        "steps": [
          "1. Process each slide in the outline sequentially",
          "2. For each bullet point, retrieve corresponding data from queryResults using dataMapping",
          "3. If requiresData=true, extract specific metrics/insights from query results",
          "4. Expand bullet points with contextual information and explanations",
          "5. Generate sub-bullets with supporting details and data points",
          "6. Create mainText summarizing the slide's key message",
          "7. Add citations for all data-backed claims",
          "8. Prepare data visualizations based on visualHints",
          "9. Generate comprehensive speaker notes",
          "10. Add transition hints for slide flow"
        ],
        "bulletExpansionStrategy": {
          "concise": "Keep bullets short (15-20 words), data-focused",
          "detailed": "Expand with context (20-25 words), include explanations",
          "comprehensive": "Full explanations (25-30 words), rich context"
        },
        "dataIntegrationStrategy": {
          "metrics": "Embed metric values with units and context directly in bullet text",
          "comparisons": "Present baseline, current, and change clearly with percentage or absolute changes",
          "trends": "Describe trend direction and magnitude with supporting data",
          "insights": "Connect data to implications and actionable takeaways"
        }
      },
      "editingMode": {
        "description": "Regenerate content for specific slides based on edit requirements",
        "steps": [
          "1. Identify target slides from editingContext.targetSlidesForEdit",
          "2. Preserve content for non-target slides from previousContent",
          "3. For target slides, regenerate content using updated outline and query results",
          "4. Ensure consistency with preserved slides (terminology, style, formatting)",
          "5. Maintain narrative flow and transitions around edited slides",
          "6. Update citations if new data sources used",
          "7. Validate no contradictions with preserved content"
        ],
        "optimizations": [
          "Reuse unchanged content to minimize regeneration time",
          "Only query RAG engine if new data needed beyond existing queryResults",
          "Maintain consistent voice and style across edited and preserved content",
          "Update cross-references if slide numbers or content changed"
        ]
      }
    },

    "ragEngineUsage": {
      "description": "Strategy for using RAG engine beyond provided queryResults",
      "whenToUseRAG": [
        "When bullet point requires data not in queryResults",
        "When additional context needed for clarity",
        "When specific examples or details requested",
        "When cross-referencing between documents needed"
      ],
      "ragQueryGeneration": {
        "bulletPointBased": "Generate targeted query from bullet text and dataMapping",
        "contextEnrichment": "Query for supporting details to expand understanding",
        "exampleRetrieval": "Fetch specific examples or case studies from documents"
      },
      "ragResultIntegration": {
        "steps": [
          "1. Generate focused query based on bullet point needs",
          "2. Retrieve top-k relevant chunks from RAG engine",
          "3. Extract specific information (metrics, facts, examples)",
          "4. Integrate into bullet point content seamlessly",
          "5. Add citation for retrieved information"
        ]
      }
    },

    "dataVisualizationPreparation": {
      "description": "Prepare structured data for charts and visualizations",
      "chartTypes": {
        "bar_chart": {
          "useCase": "Comparing metrics across categories or time periods",
          "dataStructure": {
            "labels": ["array of category names or time periods"],
            "datasets": [{"label": "metric name", "values": ["array of numbers"]}]
          }
        },
        "line_chart": {
          "useCase": "Showing trends over time",
          "dataStructure": {
            "labels": ["array of time periods"],
            "datasets": [{"label": "metric name", "values": ["array of numbers"]}]
          }
        },
        "pie_chart": {
          "useCase": "Showing composition or distribution",
          "dataStructure": {
            "labels": ["array of segment names"],
            "datasets": [{"values": ["array of percentages or absolute values"]}]
          }
        },
        "table": {
          "useCase": "Detailed data presentation with multiple dimensions",
          "dataStructure": {
            "headers": ["array of column names"],
            "rows": [["array of values per row"]]
          }
        }
      },
      "dataExtractionStrategy": {
        "fromQueryResults": "Extract metrics, trends, comparisons from extractedData",
        "fromRAGRetrieval": "Parse numerical data from retrieved chunks if not in queryResults",
        "aggregation": "Combine data from multiple queries if needed for comprehensive visualization"
      }
    },

    "cycleModes": {
      "generationMode": {
        "description": "Generate content for all slides in presentation",
        "activeFields": [
          "presentationOutline",
          "queryResults",
          "contentRequirements"
        ],
        "ignoredFields": [
          "editingContext"
        ],
        "behavior": "Process all slides, generate comprehensive content with data integration and citations"
      },
      "editingMode": {
        "description": "Regenerate content for specific edited slides",
        "activeFields": [
          "presentationOutline (updated slides only)",
          "queryResults (new queries if applicable)",
          "editingContext"
        ],
        "requiredFields": [
          "editingContext.previousContent",
          "editingContext.targetSlidesForEdit"
        ],
        "behavior": "Regenerate only target slides, preserve others, maintain consistency and narrative flow"
      }
    }
  },

  "rationale": "Superior analytical and content writing capabilities with Claude-4-Sonnet for accurate, coherent, and well-sourced presentation content",

  "integrationPoints": {
    "inputFrom": [
      "Outline Agent (presentation outline with data mappings)",
      "Query Agent (LLM-enhanced answers and RAG retrieval results)"
    ],
    "handoffAgents": [
      "QA Agent (for content validation and accuracy checking)",
      "Image Coordination Agent (if new visualizations needed based on content)"
    ],
    "dataStores": {
      "ragEngine": "Direct access for additional context retrieval beyond queryResults",
      "redis": "Cache generated content for editing and version history"
    }
  },

